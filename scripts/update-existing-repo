#!/usr/bin/env bash
# Safely install or update the Claude Code OKF kit in an existing repo.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  bash scripts/update-existing-repo /path/to/existing-repo

Updates an existing repo without destructive overwrites:
- refreshes kit-managed scripts in place (after a backup) only when the current
  content is provably this script's own unedited output; scripts the owner
  edited are left in place with the kit version written as a numbered candidate
- merges .claude/settings.json hooks with existing settings
- appends .gitignore entries without overwriting .gitignore
- leaves existing Markdown and map files intact
- writes numbered candidates when same-name files already exist
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if [ "$#" -ne 1 ]; then
  usage >&2
  exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
KIT_VERSION="$(head -n 1 "$KIT_DIR/VERSION" 2>/dev/null || printf '0.0.0')"
TARGET="$1"

if [ ! -d "$TARGET" ]; then
  printf 'Target repo does not exist: %s\n' "$TARGET" >&2
  exit 1
fi

TARGET="$(cd "$TARGET" && pwd)"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
BACKUP_DIR="$TARGET/.okf-kit-backups/$STAMP"
MANIFEST="$TARGET/.okf-kit-backups/candidate-manifest"
mkdir -p "$BACKUP_DIR"
created=()
updated=()
skipped=()
backed_up=()
review=()
advisories=()

backup_file() {
  local path="$1"
  [ -f "$path" ] || return 0
  local rel="${path#"$TARGET"/}"
  mkdir -p "$BACKUP_DIR/$(dirname "$rel")"
  cp "$path" "$BACKUP_DIR/$rel"
  backed_up+=("$rel -> ${BACKUP_DIR#"$TARGET"/}/$rel")
}

file_digest() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    sha256sum "$1" | awk '{print $1}'
  fi
}

# The manifest records the digest of every candidate this script writes, so a
# later run can prove a candidate is its own unedited output before touching
# it. Owner-edited or unknown candidates never match and are left alone.
manifest_has() {
  local digest="$1"
  local rel="$2"
  [ -f "$MANIFEST" ] || return 1
  grep -qxF "$(printf '%s\t%s' "$digest" "$rel")" "$MANIFEST"
}

manifest_record() {
  local path="$1"
  local rel="${path#"$TARGET"/}"
  local digest
  digest="$(file_digest "$path")"
  manifest_has "$digest" "$rel" && return 0
  printf '%s\t%s\n' "$digest" "$rel" >> "$MANIFEST"
}

numbered_path() {
  local dest="$1"
  local dir base ext stem candidate n
  dir="$(dirname "$dest")"
  base="$(basename "$dest")"

  if [[ "$base" == *.* ]]; then
    ext=".${base##*.}"
    stem="${base%.*}"
  else
    ext=""
    stem="$base"
  fi

  n=2
  candidate="$dir/${stem}.${n}${ext}"
  while [ -e "$candidate" ]; do
    n=$((n + 1))
    candidate="$dir/${stem}.${n}${ext}"
  done

  printf '%s\n' "$candidate"
}

existing_matching_candidate() {
  local src="$1"
  local dest="$2"
  local dir base ext stem candidate n
  dir="$(dirname "$dest")"
  base="$(basename "$dest")"

  if [[ "$base" == *.* ]]; then
    ext=".${base##*.}"
    stem="${base%.*}"
  else
    ext=""
    stem="$base"
  fi

  n=2
  while :; do
    candidate="$dir/${stem}.${n}${ext}"
    [ -e "$candidate" ] || break
    if cmp -s "$src" "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
    n=$((n + 1))
  done

  return 1
}

write_numbered_candidate() {
  local src="$1"
  local dest="$2"
  local label="$3"
  local candidate existing refreshed dir base ext stem n rel digest
  if cmp -s "$src" "$dest"; then
    skipped+=("$label already matches the kit content")
    return 0
  fi
  existing="$(existing_matching_candidate "$src" "$dest" || true)"
  if [ -n "$existing" ]; then
    manifest_record "$existing"
    skipped+=("$label candidate already exists at ${existing#"$TARGET"/}")
    return 0
  fi

  # Refresh stale candidates this script itself wrote (proven by manifest
  # digest) instead of numbering past them across kit releases. The first
  # provably-ours candidate is refreshed in place; further provably-ours
  # duplicates are backed up and removed. Anything else stays untouched.
  dir="$(dirname "$dest")"
  base="$(basename "$dest")"
  if [[ "$base" == *.* ]]; then
    ext=".${base##*.}"
    stem="${base%.*}"
  else
    ext=""
    stem="$base"
  fi

  refreshed=""
  n=2
  candidate="$dir/${stem}.${n}${ext}"
  while [ -e "$candidate" ]; do
    rel="${candidate#"$TARGET"/}"
    digest="$(file_digest "$candidate")"
    if manifest_has "$digest" "$rel"; then
      backup_file "$candidate"
      if [ -z "$refreshed" ]; then
        cp "$src" "$candidate"
        manifest_record "$candidate"
        refreshed="$candidate"
        review+=("$label exists; refreshed stale candidate ${rel}")
      else
        rm -f "$candidate"
        updated+=("removed superseded stale candidate ${rel}")
      fi
    fi
    n=$((n + 1))
    candidate="$dir/${stem}.${n}${ext}"
  done
  [ -n "$refreshed" ] && return 0

  candidate="$(numbered_path "$dest")"
  mkdir -p "$(dirname "$candidate")"
  cp "$src" "$candidate"
  manifest_record "$candidate"
  review+=("$label exists; wrote candidate ${candidate#"$TARGET"/}")
}

write_numbered_content_candidate() {
  local dest="$1"
  local label="$2"
  local tmp
  tmp="$(mktemp "$BACKUP_DIR/candidate.XXXXXX")"
  cat > "$tmp"
  write_numbered_candidate "$tmp" "$dest" "$label"
  rm -f "$tmp"
}

# Kit-managed scripts are refreshed in place only when the target's current
# content is provably this script's own unedited output (installed digest
# recorded in the manifest). Content the owner edited — or content with no
# recorded provenance, e.g. a fresh clone whose manifest was never synced —
# is preserved, with the kit version staged as a numbered candidate for
# review instead (ADR 0013). Identical content records itself so pre-manifest
# installs opt in after one run.
install_kit_script() {
  local src="$1"
  local dest="$2"
  local label="$3"
  local rel="${dest#"$TARGET"/}"
  local digest
  mkdir -p "$(dirname "$dest")"
  if [ ! -f "$dest" ]; then
    cp "$src" "$dest"
    manifest_record "$dest"
    created+=("$rel")
    return 0
  fi
  if cmp -s "$src" "$dest"; then
    manifest_record "$dest"
    skipped+=("$rel already current")
    return 0
  fi
  digest="$(file_digest "$dest")"
  if manifest_has "$digest" "$rel"; then
    backup_file "$dest"
    cp "$src" "$dest"
    manifest_record "$dest"
    updated+=("$rel")
    return 0
  fi
  write_numbered_candidate "$src" "$dest" "$label"
}

append_gitignore_entry() {
  local entry="$1"
  if [ ! -f "$TARGET/.gitignore" ]; then
    touch "$TARGET/.gitignore"
    created+=(".gitignore")
  fi

  if grep -qxF "$entry" "$TARGET/.gitignore"; then
    skipped+=(".gitignore already has $entry")
  else
    printf '%s\n' "$entry" >> "$TARGET/.gitignore"
    updated+=(".gitignore appended $entry")
  fi
}

merge_settings() {
  local kit_settings="$KIT_DIR/settings.json"
  local target_settings="$TARGET/.claude/settings.json"
  mkdir -p "$TARGET/.claude"

  if [ ! -f "$target_settings" ]; then
    cp "$kit_settings" "$target_settings"
    created+=(".claude/settings.json")
    return 0
  fi

  backup_file "$target_settings"

  python3 - "$kit_settings" "$target_settings" <<'PY'
import json
import sys

kit_path, target_path = sys.argv[1], sys.argv[2]

with open(kit_path, "r", encoding="utf-8") as f:
    kit = json.load(f)

with open(target_path, "r", encoding="utf-8") as f:
    target = json.load(f)

target.setdefault("hooks", {})

for event, kit_entries in kit.get("hooks", {}).items():
    target_entries = target["hooks"].setdefault(event, [])
    existing = {
        json.dumps(entry, sort_keys=True, separators=(",", ":"))
        for entry in target_entries
    }
    for entry in kit_entries:
        key = json.dumps(entry, sort_keys=True, separators=(",", ":"))
        if key not in existing:
            target_entries.append(entry)
            existing.add(key)

kit_permissions = kit.get("permissions", {})
if kit_permissions:
    target_permissions = target.setdefault("permissions", {})
    for key, kit_rules in kit_permissions.items():
        target_rules = target_permissions.setdefault(key, [])
        for rule in kit_rules:
            if rule not in target_rules:
                target_rules.append(rule)

with open(target_path, "w", encoding="utf-8") as f:
    json.dump(target, f, indent=2)
    f.write("\n")
PY
  updated+=(".claude/settings.json merged hooks and permissions")
}

# --- Brownfield knowledge detection (ADR 0018) ------------------------------
# A target that already keeps specs or ADRs in its own arrangement gets the
# kit pointed at that arrangement instead of a parallel empty tree. Priority:
# a layout block in an existing docs/okf-map.yml, then filesystem detection,
# then the canonical defaults.

map_layout_value() {
  local key="$1"
  local target_map="$TARGET/docs/okf-map.yml"
  [ -f "$target_map" ] || return 0
  awk -v key="$key" '
    function clean(s) {
      gsub(/#.*/, "", s)
      gsub(/^[[:space:]"'\'']+/, "", s)
      gsub(/[[:space:]"'\'']+$/, "", s)
      return s
    }
    /^layout:/ { in_layout = 1; next }
    /^[^[:space:]#]/ { in_layout = 0 }
    in_layout {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      if (index(line, key ":") == 1) {
        sub(key ":", "", line)
        print clean(line)
        exit
      }
    }
  ' "$target_map"
}

# Second-agent hook mirrors (ADR 0021): a top-level `mirrors:` list in the
# target's docs/okf-map.yml names the directories that keep byte-identical
# copies of the two kit hooks for another agent. Declared, never detected.
# Trailing slashes are stripped here, matching the SessionStart hook and
# verify-install parsers, so `- .codex/hooks/` declares the same mirror as
# `- .codex/hooks` for every consumer — including the undeclared-mirror
# advisory below, which compares against this list verbatim.
map_mirror_dirs() {
  local target_map="$TARGET/docs/okf-map.yml"
  [ -f "$target_map" ] || return 0
  awk '
    function clean(s) {
      gsub(/#.*/, "", s)
      gsub(/^[[:space:]"'\'']+/, "", s)
      gsub(/[[:space:]"'\''\/]+$/, "", s)
      return s
    }
    /^mirrors:/ { in_mirrors = 1; next }
    /^[^[:space:]#]/ { in_mirrors = 0 }
    in_mirrors {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      if (line ~ /^-/) {
        sub(/^-[[:space:]]*/, "", line)
        line = clean(line)
        if (line != "") print line
      }
    }
  ' "$target_map"
}

# Output capture instead of `| grep -q .`: the early-exit reader races the
# find writer under pipefail (see is_import_shim). `head` bounds the capture
# and its content is deterministic regardless of writer signaling.
dir_has_md() {
  [ -n "$(find "$1" -maxdepth 1 -name '*.md' ! -name 'index.md' 2>/dev/null | head -n 1)" ]
}

detect_specs_dir() {
  local candidate
  for candidate in docs/specs docs/specifications docs/specification \
    docs/architecture/specification docs/architecture/specs; do
    if [ -d "$TARGET/$candidate" ] && dir_has_md "$TARGET/$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  printf 'docs/specs\n'
}

detect_adr_dir() {
  local candidate
  for candidate in docs/adr docs/adrs docs/decisions docs/architecture/decisions; do
    if [ -d "$TARGET/$candidate" ] \
      && [ -n "$(find "$TARGET/$candidate" -maxdepth 1 -name '[0-9]*-*.md' 2>/dev/null | head -n 1)" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  printf 'docs/adr\n'
}

SPECS_DIR="$(map_layout_value specs_dir)"
[ -n "$SPECS_DIR" ] || SPECS_DIR="$(detect_specs_dir)"
SPECS_DIR="${SPECS_DIR%/}"
ADR_DIR="$(map_layout_value adr_dir)"
[ -n "$ADR_DIR" ] || ADR_DIR="$(detect_adr_dir)"
ADR_DIR="${ADR_DIR%/}"

CANONICAL_LAYOUT=1
if [ "$SPECS_DIR" != "docs/specs" ] || [ "$ADR_DIR" != "docs/adr" ]; then
  CANONICAL_LAYOUT=0
fi

# The kit version this target was on before this run, read from the stamp file
# ahead of the restamp below. It names the release whose template the playbook
# candidate review must diff against (see write_playbook_template_delta).
STAMP_FILE="$(map_layout_value stamp_file)"
[ -n "$STAMP_FILE" ] || STAMP_FILE="docs/index.md"
PRIOR_KIT_VERSION=""
if [ -f "$TARGET/$STAMP_FILE" ]; then
  PRIOR_KIT_VERSION="$(grep -m1 -E '^kit_version:' "$TARGET/$STAMP_FILE" \
    | sed -E 's/^kit_version:[[:space:]]*"?//; s/"?[[:space:]]*$//' || true)"
fi

# Undeclared mirror advisory (ADRs 0021, 0024): the declared-mirror sync below
# covers only directories in the map's `mirrors:` list, so a byte-identical
# hook copy elsewhere starts drifting with this very release. Detection must
# look at the pre-refresh originals — once this run refreshes .claude/hooks, a
# mirror of the previous release no longer matches anything on disk and the
# drift the advisory exists to name would go unreported. Same warn-only rule
# as verify-install and the SessionStart hook: byte-identical matches only,
# and detection never drives a sync.
detect_undeclared_mirrors() {
  local declared_flat seen found rel mirror_dir hook ref
  declared_flat=" $(map_mirror_dirs | tr '\n' ' ') "
  seen=""
  while IFS= read -r found; do
    [ -n "$found" ] || continue
    rel="${found#"$TARGET"/}"
    case "$rel" in */*) ;; *) continue ;; esac
    mirror_dir="${rel%/*}"
    hook="${rel##*/}"
    [ "$mirror_dir" = ".claude/hooks" ] && continue
    case "$declared_flat" in *" $mirror_dir "*) continue ;; esac
    case " $seen " in *" $mirror_dir "*) continue ;; esac
    ref="$TARGET/.claude/hooks/$hook"
    [ -f "$ref" ] || ref="$KIT_DIR/scripts/$hook"
    cmp -s "$ref" "$found" || continue
    seen="${seen:+$seen }$mirror_dir"
    advisories+=("undeclared kit hook mirror at $mirror_dir was not synced by this run; declare it in a top-level mirrors: list in docs/okf-map.yml (mirrors: with entry - $mirror_dir) so kit upgrades keep it current, or re-copy the .claude/hooks/ files by hand this once")
  done < <(find "$TARGET" -maxdepth 4 \( -name .git -o -name .okf-kit-backups -o -name node_modules \) -prune -o -type f \( -name check-docs-sync.sh -o -name check-okf-version.sh \) -print 2>/dev/null)
}
detect_undeclared_mirrors

mkdir -p "$TARGET/.claude/hooks" "$TARGET/scripts" "$TARGET/$SPECS_DIR/_drafts" "$TARGET/$ADR_DIR"

# Owner-carrying templates get the target's git identity substituted at
# install time: bracket placeholders read as YAML lists and fail strict
# frontmatter validators in target repos. Falls back to the placeholder when
# no identity is configured; the goal interview fills it then.
OWNER_NAME="$(git -C "$TARGET" config user.name 2>/dev/null || true)"
[ -n "$OWNER_NAME" ] || OWNER_NAME="[owner name]"

render_owner() {
  awk -v owner="$OWNER_NAME" \
    'BEGIN { gsub(/&/, "\\\\&", owner) } { gsub(/\[owner name\]/, owner); print }' \
    "${1:--}"
}

# Playbook staging: when AGENTS.md is the repo's real playbook and CLAUDE.md
# is absent or an @-import shim, the kit playbook lands as an AGENTS.md
# candidate instead of a CLAUDE.2.md that competes with the shim. Preloaded
# import lines are rewritten to the detected layout so they resolve to the
# real indexes.
render_playbook() {
  sed -e "s|^@docs/specs/index.md$|@$SPECS_DIR/index.md|" \
    -e "s|^@docs/adr/index.md$|@$ADR_DIR/index.md|" \
    "$KIT_DIR/templates/CLAUDE.md" | render_owner
}

is_import_shim() {
  local f="$1"
  [ -f "$f" ] || return 1
  grep -qE '^@' "$f" || return 1
  # Pure shim: nothing but @-imports and blank lines. Single grep, no
  # pipeline: under `set -o pipefail` a `grep -v | grep -q` pair races —
  # the reader exits on its first match and the writer takes SIGPIPE (141),
  # which pipefail turns into a bogus "pure shim" on real-size playbooks.
  if ! grep -qvE '^(@|[[:space:]]*$)' "$f"; then
    return 0
  fi
  # Commented shim (ADRs 0022, 0025): an @AGENTS.md import plus short
  # explanatory prose still redirects to AGENTS.md. A heading disqualifies
  # only when the @AGENTS.md import sits under it — a real playbook imports
  # AGENTS.md beneath its own headings, while a shim redirects first and may
  # then carry the kit's preloaded-context block (heading, prose, imports).
  # Length beyond the budget still means a real playbook.
  grep -qxF '@AGENTS.md' "$f" || return 1
  # grep -m 1 stops the producer itself; a `| head -n 1` consumer would race
  # the same way under pipefail on files with many matches.
  import_line="$(grep -m 1 -nxF '@AGENTS.md' "$f" | cut -d: -f1)"
  first_heading="$(grep -m 1 -nE '^#' "$f" | cut -d: -f1 || true)"
  if [ -n "$first_heading" ] && [ "$first_heading" -lt "$import_line" ]; then
    return 1
  fi
  [ "$(grep -cvE '^[[:space:]]*$' "$f")" -le 15 ]
}

# Template-delta review aid: a playbook candidate staged after releases of
# drift is reviewed by separating the kit's template delta from the owner's
# fills (the okf-kit-upgrade skill's candidate-review step). This run holds
# every ingredient of that delta — the stamp names the installed release and
# the kit clone's history carries its template — so it is written next to the
# backups instead of leaving the reviewer to re-derive it in the kit clone.
# Best-effort: any missing ingredient (no prior stamp, no git history, a
# version with no release commit) skips silently and review falls back to the
# skill's manual technique. The raw templates are diffed, not the rendered
# output — the delta describes what the kit changed, and rendering only
# substitutes the owner name identically on both sides.
write_playbook_template_delta() {
  local commit release_commit="" old_template delta
  [ -n "$PRIOR_KIT_VERSION" ] || return 0
  [ "$PRIOR_KIT_VERSION" != "$KIT_VERSION" ] || return 0
  git -C "$KIT_DIR" rev-parse --git-dir >/dev/null 2>&1 || return 0
  while IFS= read -r commit; do
    if [ "$(git -C "$KIT_DIR" show "$commit:VERSION" 2>/dev/null)" = "$PRIOR_KIT_VERSION" ]; then
      release_commit="$commit"
      break
    fi
  done < <(git -C "$KIT_DIR" log --format=%H -- VERSION 2>/dev/null)
  [ -n "$release_commit" ] || return 0
  old_template="$(mktemp "$BACKUP_DIR/template.XXXXXX")"
  if ! git -C "$KIT_DIR" show "$release_commit:templates/CLAUDE.md" > "$old_template" 2>/dev/null; then
    rm -f "$old_template"
    return 0
  fi
  delta="$BACKUP_DIR/CLAUDE.md.template-delta.diff"
  if diff -u --label "templates/CLAUDE.md@$PRIOR_KIT_VERSION" \
    --label "templates/CLAUDE.md@$KIT_VERSION" \
    "$old_template" "$KIT_DIR/templates/CLAUDE.md" > "$delta"; then
    rm -f "$delta"
  else
    advisories+=("playbook template changed since kit $PRIOR_KIT_VERSION; the kit-only delta is at ${delta#"$TARGET"/} — merge that delta into the live playbook instead of re-deriving what changed (okf-kit-upgrade candidate-review step)")
  fi
  rm -f "$old_template"
}

# The delta is written only when this run actually staged or refreshed a
# playbook candidate — tracked by growth of the review list around the call.
playbook_review_count="${#review[@]}"

if [ -f "$TARGET/AGENTS.md" ] && { [ ! -f "$TARGET/CLAUDE.md" ] || is_import_shim "$TARGET/CLAUDE.md"; }; then
  # Process substitution, not a pipe: the candidate machinery mutates the
  # summary arrays and must run in this shell.
  write_numbered_content_candidate "$TARGET/AGENTS.md" "AGENTS.md (kit playbook; this repo is AGENTS.md-first)" < <(render_playbook)
  if [ ! -f "$TARGET/CLAUDE.md" ]; then
    {
      printf '@AGENTS.md\n'
      printf '@docs/GOAL.md\n'
      printf '@%s/index.md\n' "$SPECS_DIR"
      printf '@%s/index.md\n' "$ADR_DIR"
    } > "$TARGET/CLAUDE.md"
    created+=("CLAUDE.md (import shim; AGENTS.md stays the playbook)")
  else
    skipped+=("CLAUDE.md import shim left untouched; kit playbook staged beside AGENTS.md")
  fi
elif [ -f "$TARGET/CLAUDE.md" ]; then
  write_numbered_content_candidate "$TARGET/CLAUDE.md" "CLAUDE.md" < <(render_playbook)
else
  render_playbook > "$TARGET/CLAUDE.md"
  created+=("CLAUDE.md")
fi

if [ "${#review[@]}" -gt "$playbook_review_count" ]; then
  write_playbook_template_delta
fi

merge_settings

install_kit_script "$KIT_DIR/scripts/check-docs-sync.sh" "$TARGET/.claude/hooks/check-docs-sync.sh" ".claude/hooks/check-docs-sync.sh"
install_kit_script "$KIT_DIR/scripts/check-okf-version.sh" "$TARGET/.claude/hooks/check-okf-version.sh" ".claude/hooks/check-okf-version.sh"

# Declared mirrors get the same hooks through the same provenance path as the
# .claude/hooks/ originals: refreshed in place only when provably unedited kit
# output, preserved with a numbered candidate otherwise (ADRs 0013, 0021).
# Hooks only — mirror skills carry per-agent substitutions the kit cannot
# reproduce, so they stay owner-managed.
while IFS= read -r mirror_dir; do
  [ -n "$mirror_dir" ] || continue
  mirror_dir="${mirror_dir%/}"
  case "$mirror_dir" in
    /*|*../*|*/..|..) skipped+=("mirror $mirror_dir ignored (must be a repo-relative path without ..)"); continue ;;
    .claude/hooks) skipped+=("mirror .claude/hooks ignored (it is the original, not a mirror)"); continue ;;
  esac
  install_kit_script "$KIT_DIR/scripts/check-docs-sync.sh" "$TARGET/$mirror_dir/check-docs-sync.sh" "$mirror_dir/check-docs-sync.sh"
  install_kit_script "$KIT_DIR/scripts/check-okf-version.sh" "$TARGET/$mirror_dir/check-okf-version.sh" "$mirror_dir/check-okf-version.sh"
done < <(map_mirror_dirs)

install_kit_script "$KIT_DIR/scripts/okf" "$TARGET/scripts/okf" "scripts/okf"
install_kit_script "$KIT_DIR/templates/skills/okf-goal-interview/SKILL.md" "$TARGET/.claude/skills/okf-goal-interview/SKILL.md" ".claude/skills/okf-goal-interview/SKILL.md"
install_kit_script "$KIT_DIR/templates/skills/okf-acceptance-pass/SKILL.md" "$TARGET/.claude/skills/okf-acceptance-pass/SKILL.md" ".claude/skills/okf-acceptance-pass/SKILL.md"
install_kit_script "$KIT_DIR/templates/skills/okf-adr-review/SKILL.md" "$TARGET/.claude/skills/okf-adr-review/SKILL.md" ".claude/skills/okf-adr-review/SKILL.md"
install_kit_script "$KIT_DIR/templates/skills/okf-kit-upgrade/SKILL.md" "$TARGET/.claude/skills/okf-kit-upgrade/SKILL.md" ".claude/skills/okf-kit-upgrade/SKILL.md"
install_kit_script "$KIT_DIR/templates/skills/okf-adopt/SKILL.md" "$TARGET/.claude/skills/okf-adopt/SKILL.md" ".claude/skills/okf-adopt/SKILL.md"
install_kit_script "$KIT_DIR/templates/skills/okf-second-agent/SKILL.md" "$TARGET/.claude/skills/okf-second-agent/SKILL.md" ".claude/skills/okf-second-agent/SKILL.md"

# Second-agent skill-set pairing advisory (ADR 0024): the kit refreshes only
# .claude/skills and never syncs adapted copies, so a release that adds a
# skill leaves a second agent's set silently unpaired — a repo with a parity
# gate finds out from a red build, one without finds out never. Advisory
# only, and only for skill homes that already opted into the okf-* set; the
# okf-second-agent skill carries the adaptation procedure.
check_skill_pairing() {
  local skill_home dir name skill paired missing extra
  for skill_home in .agents/skills .codex/skills; do
    dir="$TARGET/$skill_home"
    [ -d "$dir" ] || continue
    paired=""
    missing=""
    extra=""
    for skill in "$TARGET/.claude/skills"/okf-*/; do
      [ -d "$skill" ] || continue
      name="$(basename "$skill")"
      if [ -d "$dir/$name" ]; then
        paired=1
      else
        missing="${missing:+$missing, }$name"
      fi
    done
    for skill in "$dir"/okf-*/; do
      [ -d "$skill" ] || continue
      name="$(basename "$skill")"
      [ -d "$TARGET/.claude/skills/$name" ] || extra="${extra:+$extra, }$name"
    done
    if { [ -n "$paired" ] || [ -n "$extra" ]; } && [ -n "$missing" ]; then
      advisories+=("second-agent skill home $skill_home is missing: $missing — adapted skills are owner-managed and never synced by the kit; port the missing ones per the okf-second-agent skill to keep the sets paired")
    fi
    if [ -n "$extra" ]; then
      advisories+=("second-agent skill home $skill_home carries okf-* skills with no .claude/skills counterpart: $extra")
    fi
  done
}
check_skill_pairing

# The installed map records the detected layout so every kit tool follows it
# from the first session; canonical layouts get the template unchanged.
render_map() {
  cat "$KIT_DIR/okf-map.yml"
  if [ "$CANONICAL_LAYOUT" -eq 0 ]; then
    printf '\n# Detected by update-existing-repo: this repo keeps its knowledge here.\n'
    printf 'layout:\n'
    if [ "$SPECS_DIR" != "docs/specs" ]; then
      printf '  specs_dir: %s\n' "$SPECS_DIR"
    fi
    if [ "$ADR_DIR" != "docs/adr" ]; then
      printf '  adr_dir: %s\n' "$ADR_DIR"
    fi
  fi
}

# A populated map is the owner's working mapping: the template candidate
# beside it carries no mappings worth reviewing, so — as with a filled goal
# below (ADR 0018) — none is written. The candidate still lands when layout
# detection found a non-canonical tree the live map does not record, because
# then it carries the layout: block every kit tool needs.
map_is_populated() {
  grep -qE '^[[:space:]]*-[[:space:]]*source:' "$TARGET/docs/okf-map.yml" 2>/dev/null
}

map_records_layout() {
  [ "$CANONICAL_LAYOUT" -eq 1 ] && return 0
  grep -qE '^layout:' "$TARGET/docs/okf-map.yml" 2>/dev/null
}

if [ -f "$TARGET/docs/okf-map.yml" ]; then
  if map_is_populated && map_records_layout; then
    skipped+=("docs/okf-map.yml already populated; no template candidate written (new map conventions are documented in the kit's okf-map.yml header)")
  else
    write_numbered_content_candidate "$TARGET/docs/okf-map.yml" "docs/okf-map.yml" < <(render_map)
  fi
else
  render_map > "$TARGET/docs/okf-map.yml"
  created+=("docs/okf-map.yml")
fi

# A goal file that already carries the kit's structure with no template
# brackets is the owner's finished goal — a template candidate beside it is
# pure review noise, so none is written (ADR 0018).
goal_is_filled() {
  local f="$TARGET/docs/GOAL.md"
  if [ ! -f "$f" ]; then return 1; fi
  if grep -q 'Template. Fill every \[bracket\]' "$f"; then return 1; fi
  if grep -qF '[app | service | utility]' "$f"; then return 1; fi
  # Tolerant heading detection (ADR 0018 spirit): a filled goal may title its
  # headings ("# Goal: AWS Public Change Alerting") and name its backlog
  # "## Implementation milestones" — heading level and prefix are the owner's
  # style, not a signal the goal is unfilled.
  if ! grep -qiE '^#{1,6} *goal(:| |$)' "$f"; then return 1; fi
  if ! grep -qiE '^#{1,6}[^#]*milestones' "$f"; then return 1; fi
  return 0
}

if [ -f "$TARGET/docs/GOAL.md" ]; then
  if goal_is_filled; then
    skipped+=("docs/GOAL.md already filled; no template candidate written")
  else
    write_numbered_content_candidate "$TARGET/docs/GOAL.md" "docs/GOAL.md" < <(render_owner "$KIT_DIR/templates/GOAL.md")
  fi
else
  render_owner "$KIT_DIR/templates/GOAL.md" > "$TARGET/docs/GOAL.md"
  created+=("docs/GOAL.md")
fi

# Bundle-root links follow the detected layout, and knowledge surfaces the
# canonical tree has no slot for (runbooks, machine-readable schemas) get
# linked when present.
bundle_link() {
  local rel="$1"
  case "$rel" in
    docs/*) printf '%s\n' "${rel#docs/}" ;;
    *) printf '../%s\n' "$rel" ;;
  esac
}

docs_index_content() {
  printf -- '---\nokf_version: "0.1"\nkit_version: "%s"\n---\n\n# Knowledge bundle\n\n' "$KIT_VERSION"
  printf -- '- [Goal](GOAL.md)\n'
  printf -- '- [Specs](%s/index.md)\n' "$(bundle_link "$SPECS_DIR")"
  printf -- '- [ADRs](%s/index.md)\n' "$(bundle_link "$ADR_DIR")"
  printf -- '- [Log](log.md)\n'
  printf -- '- [Source map](okf-map.yml)\n'
  if [ -d "$TARGET/docs/runbooks" ]; then
    printf -- '- [Runbooks](runbooks/)\n'
  fi
  if [ -d "$TARGET/schemas" ]; then
    printf -- '- [Schemas](../schemas/)\n'
  fi
}

# In-place kit_version stamping (ADR 0019; the append_gitignore_entry
# precedent for mechanical one-line additions). The stamp is corrected when it
# differs, inserted after okf_version when that line exists, and otherwise
# inserted right after the opening frontmatter fence — callers guarantee the
# file opens with one.
stamp_kit_version_in() {
  local stamp_path="$1"
  local rel="${stamp_path#"$TARGET"/}"
  local existing_kit_version tmp_stamp
  existing_kit_version="$(grep -m1 -E '^kit_version:' "$stamp_path" \
    | sed -E 's/^kit_version:[[:space:]]*"?//; s/"?[[:space:]]*$//' || true)"
  if [ "$existing_kit_version" = "$KIT_VERSION" ]; then
    skipped+=("$rel already stamped kit_version $KIT_VERSION")
    return 0
  fi
  backup_file "$stamp_path"
  tmp_stamp="$(mktemp "$BACKUP_DIR/stamp.XXXXXX")"
  if [ -n "$existing_kit_version" ]; then
    sed -E "s/^kit_version:.*/kit_version: \"$KIT_VERSION\"/" \
      "$stamp_path" > "$tmp_stamp"
    mv "$tmp_stamp" "$stamp_path"
    updated+=("$rel kit_version restamped $existing_kit_version -> $KIT_VERSION")
  elif grep -qE '^okf_version:' "$stamp_path"; then
    awk -v kv="kit_version: \"$KIT_VERSION\"" \
      '{ print } /^okf_version:/ && !done { print kv; done = 1 }' \
      "$stamp_path" > "$tmp_stamp"
    mv "$tmp_stamp" "$stamp_path"
    updated+=("$rel stamped kit_version $KIT_VERSION")
  else
    awk -v kv="kit_version: \"$KIT_VERSION\"" \
      'NR == 1 { print; print kv; next } { print }' \
      "$stamp_path" > "$tmp_stamp"
    mv "$tmp_stamp" "$stamp_path"
    updated+=("$rel stamped kit_version $KIT_VERSION")
  fi
}

if [ "$STAMP_FILE" != "docs/index.md" ]; then
  # Layout-relocated stamp (ADR 0018): the declared stamp_file is the version
  # authority every kit tool reads, so the stamp lands there and only there —
  # stamping the default path too would leave two stamps and a SessionStart
  # drift note that never clears. The relocated file is the owner's: it is
  # stamped in place when it opens with frontmatter, and otherwise reported,
  # never replaced with a candidate. No docs/index.md bundle root is created
  # beside an arrangement the owner deliberately relocated.
  if [ ! -f "$TARGET/$STAMP_FILE" ]; then
    skipped+=("$STAMP_FILE (layout stamp_file) not found; kit_version not stamped — create the file or fix the layout entry")
  elif [ "$(head -n 1 "$TARGET/$STAMP_FILE")" = '---' ]; then
    stamp_kit_version_in "$TARGET/$STAMP_FILE"
  else
    skipped+=("$STAMP_FILE (layout stamp_file) has no opening frontmatter block; add kit_version: \"$KIT_VERSION\" to it by hand")
  fi
elif [ ! -f "$TARGET/docs/index.md" ]; then
  docs_index_content > "$TARGET/docs/index.md"
  created+=("docs/index.md")
elif [ "$(head -n 1 "$TARGET/docs/index.md")" = '---' ] \
  && grep -qE '^okf_version:' "$TARGET/docs/index.md"; then
  stamp_kit_version_in "$TARGET/docs/index.md"
else
  write_numbered_content_candidate "$TARGET/docs/index.md" "docs/index.md" < <(docs_index_content)
fi

# Heading-only starters carry no kit content worth reviewing, so an existing
# file gets no numbered candidate; a missing index is created seeded with the
# knowledge files already beside it, never as an empty shell next to work the
# kit did not write (ADR 0018).
if [ ! -f "$TARGET/docs/log.md" ]; then
  cat > "$TARGET/docs/log.md" <<'EOF'
# Log
EOF
  created+=("docs/log.md")
else
  skipped+=("docs/log.md exists; left untouched")
fi

seed_index_content() {
  local dir="$1"
  local heading="$2"
  local f base title printed=0
  printf '%s\n' "$heading"
  for f in "$TARGET/$dir"/*.md; do
    [ -e "$f" ] || continue
    base="$(basename "$f")"
    case "$base" in
      index.md|*.[0-9].md|*.[0-9][0-9].md) continue ;;
    esac
    if [ "$printed" -eq 0 ]; then
      printf '\n'
      printed=1
    fi
    title="$(grep -m1 -E '^title:' "$f" 2>/dev/null | sed -E 's/^title:[[:space:]]*//; s/[[:space:]]+$//' || true)"
    if [ -z "$title" ]; then
      title="$(grep -m1 -E '^#[[:space:]]' "$f" 2>/dev/null | sed -E 's/^#[[:space:]]+//; s/[[:space:]]+$//' || true)"
    fi
    [ -n "$title" ] || title="$base"
    printf -- '- [%s](%s)\n' "$title" "$base"
  done
}

if [ ! -f "$TARGET/$SPECS_DIR/index.md" ]; then
  seed_index_content "$SPECS_DIR" "# Specs" > "$TARGET/$SPECS_DIR/index.md"
  created+=("$SPECS_DIR/index.md")
else
  skipped+=("$SPECS_DIR/index.md exists; left untouched")
fi

if [ ! -f "$TARGET/$ADR_DIR/index.md" ]; then
  seed_index_content "$ADR_DIR" "# ADRs" > "$TARGET/$ADR_DIR/index.md"
  created+=("$ADR_DIR/index.md")
else
  skipped+=("$ADR_DIR/index.md exists; left untouched")
fi

append_gitignore_entry '.claude/settings.local.json'
append_gitignore_entry 'CLAUDE.local.md'
append_gitignore_entry '.okf-kit-backups/'
append_gitignore_entry '.DS_Store'
append_gitignore_entry '.env'
append_gitignore_entry '.env.*'
append_gitignore_entry '!.env.example'

python3 -m json.tool "$TARGET/.claude/settings.json" >/dev/null
bash -n "$TARGET/scripts/okf"
bash -n "$TARGET/.claude/hooks/check-docs-sync.sh"
bash -n "$TARGET/.claude/hooks/check-okf-version.sh"

print_list() {
  local title="$1"
  shift
  printf '\n%s\n' "$title"
  if [ "$#" -eq 0 ]; then
    printf '  none\n'
    return 0
  fi
  local item
  for item in "$@"; do
    printf '  - %s\n' "$item"
  done
}

printf '\nClaude Code OKF kit update complete\n'
printf 'Target: %s\n' "$TARGET"
printf 'Backups: %s\n' "${BACKUP_DIR#"$TARGET"/}"
print_list 'Created:' "${created[@]}"
print_list 'Updated:' "${updated[@]}"
print_list 'Skipped:' "${skipped[@]}"
print_list 'Backed up:' "${backed_up[@]}"
print_list 'Needs review:' "${review[@]}"
print_list 'Advisories:' "${advisories[@]}"
printf '\nVerification run:\n'
printf '  - python3 -m json.tool .claude/settings.json\n'
printf '  - bash -n scripts/okf\n'
printf '  - bash -n .claude/hooks/check-docs-sync.sh\n'
printf '  - bash -n .claude/hooks/check-okf-version.sh\n'
printf '\nNext steps:\n'
printf '  1. Review numbered candidate files listed above.\n'
printf '  2. Merge any desired candidate content into existing files.\n'
printf '  3. If docs/GOAL.md or CLAUDE.md still has template brackets, open the repo\n'
printf '     in Claude Code for the goal interview, or edit them by hand.\n'
printf '  4. Run bash scripts/okf check-stale.\n'
