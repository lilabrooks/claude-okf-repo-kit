#!/usr/bin/env bash
# Report target-repo template placeholders that still need human input.

set -u

usage() {
  cat <<'EOF'
Usage:
  bash scripts/check-placeholders /path/to/target-repo

Warns when CLAUDE.md, docs/GOAL.md, or docs/okf-map.yml still look like the
install template. This script does not modify files.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if [ "$#" -ne 1 ]; then
  usage >&2
  exit 2
fi

TARGET="$1"
if [ ! -d "$TARGET" ]; then
  printf 'Target repo does not exist: %s\n' "$TARGET" >&2
  exit 1
fi
TARGET="$(cd "$TARGET" && pwd)"
issues=()

add_issue() {
  issues+=("$1")
}

# OKF-SHARED-BEGIN playbook-placeholders
# Canonical list of the installed playbook's unfilled-template blanks — the
# bracketed spots the goal interview fills in. Byte-identical in every kit
# script that carries it; `make parity` enforces the match. Curated rather
# than scanned out of the template, because the template also carries brackets
# that stay legitimate in a filled playbook: the `tags: [...]` frontmatter
# list and the `[paths...]`/`[title]` argument spellings in the helper usage
# lines. A bare `\[.*\]` scan matches those and calls every playbook unfilled.
OKF_PLAYBOOK_PLACEHOLDERS='[what exists today, 1-2 sentences]
[what done looks like, concrete nouns]
[governing ADRs and specs by path]
[verifiable criteria: test command, contract coverage, removals]
[test command]
[command]
[command, if separate]'
# OKF-SHARED-END playbook-placeholders

if [ ! -f "$TARGET/CLAUDE.md" ]; then
  add_issue "CLAUDE.md is missing"
else
  if grep -q 'Template. Fill every \[bracket\]' "$TARGET/CLAUDE.md"; then
    add_issue "CLAUDE.md still has the template comment"
  fi
  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    if grep -qF "$pattern" "$TARGET/CLAUDE.md"; then
      add_issue "CLAUDE.md still contains placeholder: $pattern"
    fi
  done <<EOF
$OKF_PLAYBOOK_PLACEHOLDERS
EOF
fi

if [ ! -f "$TARGET/docs/GOAL.md" ]; then
  add_issue "docs/GOAL.md is missing"
else
  if grep -q 'Template. Fill every \[bracket\]' "$TARGET/docs/GOAL.md"; then
    add_issue "docs/GOAL.md still has the template comment"
  fi
  for pattern in \
    '[app | service | utility]' \
    '[who has what problem, 1-2 sentences]' \
    '[test command that passes]' \
    '[first shippable slice + how to verify it]'; do
    if grep -qF "$pattern" "$TARGET/docs/GOAL.md"; then
      add_issue "docs/GOAL.md still contains placeholder: $pattern"
    fi
  done
fi

if [ ! -f "$TARGET/docs/okf-map.yml" ]; then
  add_issue "docs/okf-map.yml is missing"
else
  active_sources="$(awk '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*-[[:space:]]*source:/ { print; found=1 }
    END { if (!found) exit 1 }
  ' "$TARGET/docs/okf-map.yml" 2>/dev/null)"
  if [ -z "$active_sources" ]; then
    add_issue "docs/okf-map.yml has no active source mappings yet"
  fi
  if grep -v '^[[:space:]]*#' "$TARGET/docs/okf-map.yml" | grep -q 'path/to/module'; then
    add_issue "docs/okf-map.yml still contains the sample path/to/module mapping"
  fi
fi

printf '\nClaude Code OKF placeholder check\n'
printf 'Target: %s\n' "$TARGET"

if [ "${#issues[@]}" -eq 0 ]; then
  printf '\nNo template placeholders found.\n'
  exit 0
fi

printf '\nNeeds attention:\n'
for issue in "${issues[@]}"; do
  printf '  - %s\n' "$issue"
done

cat <<'EOF'

Next steps:
  1. Fill docs/GOAL.md with the repo's goal, success criteria, and milestones.
  2. Fill CLAUDE.md with this repo's real objective, constraints, and commands.
  3. Add real source-to-doc mappings to docs/okf-map.yml.
  4. Run this check again.
EOF

exit 1
