#!/usr/bin/env bash
# Verify that a target repo has the Claude Code OKF kit installed coherently.

set -u

usage() {
  cat <<'EOF'
Usage:
  bash scripts/verify-install /path/to/target-repo

Checks installed files, settings JSON, script syntax, required ignore entries,
and basic OKF helper execution. It does not judge project-specific content.
Honors the optional layout block in the target's docs/okf-map.yml (specs_dir,
adr_dir, stamp_file), and warns when a knowledge index lists no entries while
knowledge files sit beside it.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if [ "$#" -ne 1 ]; then
  usage >&2
  exit 2
fi

TARGET="$1"
if [ ! -d "$TARGET" ]; then
  printf 'Target repo does not exist: %s\n' "$TARGET" >&2
  exit 1
fi
TARGET="$(cd "$TARGET" && pwd)"

# Optional layout block (ADR 0018): verify the paths the target actually uses.
layout_value() {
  key="$1"
  default="$2"
  value=""
  if [ -f "$TARGET/docs/okf-map.yml" ]; then
    value="$(awk -v key="$key" '
      function clean(s) {
        gsub(/#.*/, "", s)
        gsub(/^[[:space:]"'\'']+/, "", s)
        gsub(/[[:space:]"'\'']+$/, "", s)
        return s
      }
      /^layout:/ { in_layout = 1; next }
      /^[^[:space:]#]/ { in_layout = 0 }
      in_layout {
        line = $0
        sub(/^[[:space:]]+/, "", line)
        if (index(line, key ":") == 1) {
          sub(key ":", "", line)
          print clean(line)
          exit
        }
      }
    ' "$TARGET/docs/okf-map.yml")"
  fi
  if [ -n "$value" ]; then
    printf '%s\n' "${value%/}"
  else
    printf '%s\n' "$default"
  fi
}

SPECS_DIR="$(layout_value specs_dir docs/specs)"
ADR_DIR="$(layout_value adr_dir docs/adr)"
STAMP_REL="$(layout_value stamp_file docs/index.md)"

passed=()
warnings=()
failed=()

pass() { passed+=("$1"); }
warn() { warnings+=("$1"); }
fail() { failed+=("$1"); }

check_file() {
  local rel="$1"
  if [ -f "$TARGET/$rel" ]; then
    pass "$rel exists"
  else
    fail "$rel is missing"
  fi
}

check_dir() {
  local rel="$1"
  if [ -d "$TARGET/$rel" ]; then
    pass "$rel exists"
  else
    fail "$rel is missing"
  fi
}

check_gitignore_entry() {
  local entry="$1"
  if [ ! -f "$TARGET/.gitignore" ]; then
    fail ".gitignore is missing"
  elif grep -qxF "$entry" "$TARGET/.gitignore"; then
    pass ".gitignore has $entry"
  else
    fail ".gitignore is missing $entry"
  fi
}

# An index that lists nothing while knowledge files sit beside it means the
# install produced (or kept) an empty shell next to real work — exactly the
# state a brownfield adoption should never end in (ADR 0018). Warn, don't
# fail: the owner may be mid-migration.
check_index_coverage() {
  local dir="$1"
  local index="$TARGET/$dir/index.md"
  [ -f "$index" ] || return 0
  local f base count=0
  for f in "$TARGET/$dir"/*.md; do
    [ -e "$f" ] || continue
    base="$(basename "$f")"
    case "$base" in
      index.md|*.[0-9].md|*.[0-9][0-9].md) continue ;;
    esac
    count=$((count + 1))
  done
  if [ "$count" -gt 0 ] && ! grep -q '](' "$index"; then
    warn "$dir/index.md lists no entries while $count knowledge file(s) sit beside it"
  else
    pass "$dir/index.md covers its directory"
  fi
}

print_list() {
  local title="$1"
  shift
  printf '\n%s\n' "$title"
  if [ "$#" -eq 0 ]; then
    printf '  none\n'
    return 0
  fi
  local item
  for item in "$@"; do
    printf '  - %s\n' "$item"
  done
}

check_file CLAUDE.md
check_file .claude/settings.json
check_file .claude/hooks/check-docs-sync.sh
check_file .claude/hooks/check-okf-version.sh
check_file .claude/skills/okf-goal-interview/SKILL.md
check_file .claude/skills/okf-acceptance-pass/SKILL.md
check_file .claude/skills/okf-adr-review/SKILL.md
check_file .claude/skills/okf-kit-upgrade/SKILL.md
check_file .claude/skills/okf-adopt/SKILL.md
check_file scripts/okf
check_file docs/index.md
check_file docs/GOAL.md
check_file docs/log.md
check_file "$SPECS_DIR/index.md"
check_file "$ADR_DIR/index.md"
check_file docs/okf-map.yml
check_dir "$SPECS_DIR/_drafts"
check_index_coverage "$SPECS_DIR"
check_index_coverage "$ADR_DIR"

if [ -f "$TARGET/.claude/settings.json" ]; then
  if python3 -m json.tool "$TARGET/.claude/settings.json" >/dev/null 2>&1; then
    pass ".claude/settings.json is valid JSON"
  else
    fail ".claude/settings.json is not valid JSON"
  fi

  if python3 - "$TARGET/.claude/settings.json" <<'PY' >/dev/null 2>&1
import json
import sys

settings = json.load(open(sys.argv[1], encoding="utf-8"))
commands = [
    hook.get("command", "")
    for groups in settings.get("hooks", {}).values()
    for group in groups
    for hook in group.get("hooks", [])
]
required = [
    'bash "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-docs-sync.sh"',
    'bash "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-okf-version.sh"',
]
missing = [command for command in required if command not in commands]
if missing:
    raise SystemExit("missing hook commands: " + ", ".join(missing))
PY
  then
    pass ".claude/settings.json includes required hook commands"
  else
    fail ".claude/settings.json is missing one or more required hook commands"
  fi

  if python3 - "$TARGET/.claude/settings.json" <<'PY' >/dev/null 2>&1
import json
import sys

settings = json.load(open(sys.argv[1], encoding="utf-8"))
deny = settings.get("permissions", {}).get("deny", [])
required = ["Read(./.env)", "Read(./**/.env)"]
missing = [rule for rule in required if rule not in deny]
if missing:
    raise SystemExit("missing deny rules: " + ", ".join(missing))
PY
  then
    pass ".claude/settings.json denies reading local env files"
  else
    fail ".claude/settings.json is missing the env-file read deny rules"
  fi
fi

for rel in scripts/okf .claude/hooks/check-docs-sync.sh .claude/hooks/check-okf-version.sh; do
  if [ -f "$TARGET/$rel" ]; then
    if bash -n "$TARGET/$rel" >/dev/null 2>&1; then
      pass "$rel has valid shell syntax"
    else
      fail "$rel has shell syntax errors"
    fi
  fi
done

check_gitignore_entry '.claude/settings.local.json'
check_gitignore_entry 'CLAUDE.local.md'
check_gitignore_entry '.okf-kit-backups/'
check_gitignore_entry '.DS_Store'
check_gitignore_entry '.env'
check_gitignore_entry '.env.*'
check_gitignore_entry '!.env.example'

if [ -f "$TARGET/$STAMP_REL" ]; then
  if grep -qE 'kit_version:[[:space:]]*"?[0-9]+\.[0-9]+\.[0-9]+"?' "$TARGET/$STAMP_REL"; then
    pass "$STAMP_REL declares kit_version"
  else
    warn "$STAMP_REL has no kit_version stamp; kit drift reporting stays silent (merge the docs/index numbered candidate or add the field)"
  fi
fi

if [ -f "$TARGET/scripts/okf" ]; then
  tmp="$(mktemp)"
  if OKF_ROOT="$TARGET" bash "$TARGET/scripts/okf" check-stale >"$tmp" 2>&1; then
    pass "bash scripts/okf check-stale ran"
  else
    warn "bash scripts/okf check-stale reported attention; inspect the target repo docs/source state"
  fi
  rm -f "$tmp"

  tmp="$(mktemp)"
  if OKF_ROOT="$TARGET" bash "$TARGET/scripts/okf" adr-suggest >"$tmp" 2>&1; then
    pass "bash scripts/okf adr-suggest ran"
  else
    warn "bash scripts/okf adr-suggest reported attention"
  fi
  rm -f "$tmp"
fi

if git -C "$TARGET" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  pass "target is a Git working tree"
  for rel in .claude/settings.local.json CLAUDE.local.md .okf-kit-backups/test .env; do
    if git -C "$TARGET" check-ignore -q "$rel"; then
      pass "git ignore check passes for $rel"
    else
      warn "git ignore check did not match $rel"
    fi
  done
  if git -C "$TARGET" check-ignore -q ".env.example"; then
    warn ".env.example is ignored; it should stay trackable for documented sample configuration"
  else
    pass ".env.example stays trackable"
  fi
else
  warn "target is not a Git working tree; Git ignore behavior was not checked"
fi

printf '\nClaude Code OKF kit install verification\n'
printf 'Target: %s\n' "$TARGET"
print_list 'Passed:' "${passed[@]}"
print_list 'Warnings:' "${warnings[@]}"
print_list 'Failed:' "${failed[@]}"

if [ "${#failed[@]}" -gt 0 ]; then
  printf '\nResult: failed\n'
  exit 1
fi

printf '\nResult: passed\n'
exit 0
